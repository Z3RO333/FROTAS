# Banco operacional (obrigatório)
SUPABASE_MANUTENCAO_URL=https://seu-projeto.supabase.co
SUPABASE_MANUTENCAO_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_MANUTENCAO_URL=https://seu-projeto.supabase.co

# Autenticação Microsoft Entra ID (obrigatório)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT=
NEXTAUTH_SECRET=
ALLOWED_EMAIL_DOMAIN=bemol.com.br

# URLs e chamadas internas (obrigatório em produção)
FROTAS_APP_URL=https://frotas.exemplo.com.br
NEXT_PUBLIC_APP_URL=https://frotas.exemplo.com.br
# Consumida diretamente pelo Auth.js para callbacks e redirects.
NEXTAUTH_URL=https://frotas.exemplo.com.br
FROTAS_INTERNAL_SECRET=
CHECKLIST_VISION_SECRET=
SERVER_ACTIONS_ALLOWED_ORIGINS=frotas.exemplo.com.br
FROTAS_TRUSTED_HOSTS=frotas.exemplo.com.br,gestaofrotas.azurewebsites.net
# Homologação inicial: use 1 para observar a CSP sem bloquear recursos.
CSP_REPORT_ONLY=0
# Use 1 junto com Report-Only para inventariar estilos dinâmicos das bibliotecas de UI.
CSP_STRICT_STYLE_ATTRS=1

# E-mail
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@exemplo.com.br
SENDGRID_FROM_NAME=Frotas
# Remetente e cópia do módulo de pedidos de peças.
PECAS_FROM_EMAIL=manutencaocd_orcamentos@bemol.com.br
PECAS_FROM_NAME=Manutenção CD - Orçamentos
PECAS_CC_EMAIL=manutencaocd_orcamentos@bemol.com.br
PECAS_LOGO_URL=https://seu-dominio-publico/bemol-logo-email.png
# Aliases legados opcionais; prefira SENDGRID_FROM_EMAIL/SENDGRID_FROM_NAME.
FROM_EMAIL=
FROM_NAME=
FROTAS_MANUTENCAO_EMAILS=

# Perfis/RBAC (listas separadas por vírgula; preferir cadastro em usuarios_sistema)
FROTAS_ADMIN_EMAILS=
FROTAS_DEV_EMAILS=
FROTAS_DRIVER_EMAILS=
FROTAS_PORTARIA_EMAILS=
FROTAS_APROVADOR_EMAILS=
FROTAS_GESTOR_EMAILS=
FROTAS_DEFAULT_PROFILE=

# IA: configure OpenAI ou Azure OpenAI
OPENAI_API_KEY=
OPENAI_CHECKLIST_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Serviço YOLO standalone/legado. O Next.js usa OpenAI Vision atualmente;
# estas variáveis pertencem ao container services/yolo-checklist.
YOLO_SERVICE_TOKEN=
YOLO_MODEL_PATH=yolov8n.pt
YOLO_MODEL_NAME=yolov8n-checklist
YOLO_CONFIDENCE=0.35
YOLO_OCR_GPU=false
FROTAS_TIMEZONE=America/Manaus

# Scripts de importação/migração (somente quando esses comandos forem usados)
XLSX_PATH=
PLANEJAMENTO_PATH=
RELATORIO_UNIDADES_PATH=
SUPABASE_DOCS_SERVICE_ROLE_KEY=
SUPABASE_PNEUS_SERVICE_ROLE_KEY=
# FORCE=1 habilita reprocessamento explícito em scripts compatíveis.
FORCE=0
DEBUG=0
